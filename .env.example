# Plex forbindes nemmest via /plex → "Log ind med Plex" eller `php artisan plex:login`.
# Manuel opsætning (valgfri, vinder over login):
# PLEX_URL=http://192.168.1.10:32400
# PLEX_TOKEN=
# Har din app ingen login? Så gør /plex tilgængelig uden auth:
# PLEX_RECOMMENDER_MIDDLEWARE=web
# Valgfri, men anbefalet: gratis nøgle fra https://www.themoviedb.org/settings/api
TMDB_API_KEY=
PLEX_RECOMMENDER_LANGUAGE=da-DK
# Valgfri: kun én Plex-brugers historik (ejeren er typisk 1)
PLEX_ACCOUNT_ID=
# false ved https med selvsigneret certifikat
PLEX_VERIFY_SSL=true
