# Adresse til din Plex Media Server
PLEX_URL=http://192.168.1.10:32400
# Dit Plex-token (se README)
PLEX_TOKEN=
# Valgfri, men anbefalet: gratis nøgle fra https://www.themoviedb.org/settings/api
# (både v3 "API Key" og v4 "Read Access Token" virker)
TMDB_API_KEY=
# Sprog for titler/resuméer fra TMDB
RECOMMENDER_LANGUAGE=da-DK
# Valgfri: begræns historik til én Plex-bruger (ejeren er typisk 1)
PLEX_ACCOUNT_ID=
# Sæt til false hvis du bruger https med selvsigneret certifikat
PLEX_VERIFY_SSL=true
